# App
# Production canonical is https://hydratax.uk (set this on Netlify)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth + Postgres (preferred)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key also accepted:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — WhatsApp bot Netlify function only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
# Google sign-in/up: enable in Supabase Dashboard → Authentication → Providers → Google
# (paste Google Cloud OAuth Client ID + Client Secret there — not in this file)
# Google Cloud authorized redirect URI (exact):
#   https://uytcstgitxwrwuffgmyh.supabase.co/auth/v1/callback
# Supabase Auth → URL configuration must include:
#   Site URL: https://hydratax.uk
#   Redirect URLs: https://hydratax.uk/auth/callback
#                  http://localhost:3000/auth/callback
# Run SQL: supabase/migrations/20260807000000_auth_profiles_practices.sql
# WhatsApp bot tables: supabase/migrations/20260808020000_whatsapp_bot.sql

# Meta WhatsApp Cloud API (Netlify function: /.netlify/functions/whatsapp-webhook)
# Create app → WhatsApp → API setup: https://developers.facebook.com/
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Cloudflare R2 — document file storage (S3-compatible)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=hydratax-documents
# Alert platform admins when total document storage crosses 80/90/95% of this limit
R2_STORAGE_LIMIT_GB=10
# Optional public CDN / custom domain for objects
# CLOUDFLARE_R2_PUBLIC_URL=https://docs.yourdomain.com

# Cloudflare D1 — heavy desk tables (payroll, ledger, VAT, bank)
# Create: npx wrangler login && npx wrangler d1 create hydratax-desk
# Migrate: npx wrangler d1 migrations apply hydratax-desk --remote
# API token needs Account → D1 → Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# Clerk (optional legacy — Supabase takes priority when configured)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon / DATABASE_URL (optional if using Supabase Postgres connection string)
DATABASE_URL=

# Token encryption (32-byte key as hex or base64)
TOKEN_ENCRYPTION_KEY=

# Stripe Checkout — put real keys in .env.local (never commit secrets)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Vercel Blob (fallback if R2 not set)
BLOB_READ_WRITE_TOKEN=

# Companies House Public Data API
# Free REST key: https://developer.company-information.service.gov.uk/
# Company name search needs a Live key. Default host is live when unset.
# Test keys → COMPANIES_HOUSE_ENV=test (api-sandbox…)
# Live keys → COMPANIES_HOUSE_ENV=live (default)
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_ENV=live

# Companies House software filing (CS01 / IN01 XML gateway)
# HydraTax = one software presenter for all clients (Inform Direct–style).
# Keep COMPANIES_HOUSE_ENV aligned with the XML socket:
#   live → https://xmlgw.companieshouse.gov.uk/v1-0/xmlgw/Gateway
#   test → https://xmlgw-sandpit-staging.companieshouse.gov.uk/v1-0/xmlgw/Gateway
#          (PackageReference 0012 + GatewayTest=1)
# Do NOT point live credentials at the sandpit URL, or test mode at the live URL.
# Fixed for the whole site (never collected from end users):
COMPANIES_HOUSE_PRESENTER_ID=
COMPANIES_HOUSE_PRESENTER_AUTH_CODE=
# Required for live fee-bearing filings (CS01, IN01) — monthly CH credit account
COMPANIES_HOUSE_CREDIT_ACCOUNT=
# Email registered with Companies House for this presenter account
COMPANIES_HOUSE_PRESENTER_EMAIL=
# Optional FormHeader contact (name + phone must both be set to include)
# COMPANIES_HOUSE_PRESENTER_CONTACT_NAME=HydraTax
# COMPANIES_HOUSE_PRESENTER_CONTACT_NUMBER=
# Optional FormHeader PackageReference override (live defaults to presenter ID; test defaults to 0012)
COMPANIES_HOUSE_PACKAGE_REFERENCE=
# Set to 1 to log redacted XML payloads before gateway submission (dev also logs)
# COMPANIES_HOUSE_DEBUG_XML=1
# Optional — future REST API Filing OAuth app
COMPANIES_HOUSE_OAUTH_CLIENT_ID=
COMPANIES_HOUSE_OAUTH_CLIENT_SECRET=
# Optional explicit socket override (must still match COMPANIES_HOUSE_ENV or submit is blocked)
# COMPANIES_HOUSE_XML_GATEWAY_URL=
# Optional agent address on IN01 authoriser block
# COMPANIES_HOUSE_AGENT_NAME=HYDRA CONSULTANCY SERVICES LTD
# COMPANIES_HOUSE_AGENT_PREMISE=
# COMPANIES_HOUSE_AGENT_STREET=
# COMPANIES_HOUSE_AGENT_TOWN=
# COMPANIES_HOUSE_AGENT_POSTCODE=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=HydraTax <onboarding@resend.dev>
# Optional: protect /api/cron/trial-reminders
CRON_SECRET=

# HMRC
HMRC_ENV=sandbox
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_SERVER_TOKEN=
# MTD fraud-prevention headers (VAT / ITSA REST) — not the CT Vendor ID
HMRC_VENDOR_PUBLIC_IP=
HMRC_VENDOR_LICENSE_IDS=hydratax
HMRC_VENDOR_VERSION=HydraTax=0.1.0
# Corporation Tax Online XML (SDST) — 4-digit Vendor ID goes in ChannelRouting <URI>
HMRC_CT_VENDOR_ID=
HMRC_CT_PRODUCT_NAME=HydraTax
# ETS test credentials from SDST (sandbox only — never use on live client filings)
# UTR is mandatory on every CT600: GovTalkDetails/Keys + IRheader/Keys
HMRC_CT_TEST_SENDER_ID=
HMRC_CT_TEST_PASSWORD=
HMRC_CT_TEST_UTR=

# Platform admin — single email may access /admin (ops boards, promo codes).
# Create this user in Supabase Auth with the same email + password.
# ADMIN_PASSWORD is for your records only; the app never reads it.
# Platform /admin access — comma-separated emails allowed
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MEMORY_STORE / DEMO_MODE — local empty store only. Ignored in production (Netlify).
# Never set these on hydratax.uk — clients would vanish across serverless instances.
# MEMORY_STORE=true
# DEMO_MODE=true

# Capacitor native shell (optional) — WebView loads this URL
# CAPACITOR_SERVER_URL=https://hydratax.uk
