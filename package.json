{
  "name": "hydratax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "d1:create": "wrangler d1 create hydratax-desk",
    "d1:migrate:local": "wrangler d1 migrations apply hydratax-desk --local",
    "d1:migrate:remote": "wrangler d1 migrations apply hydratax-desk --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ct-ets": "node scripts/ct600-ets-test.cjs",
    "fix:mojibake": "node scripts/fix-mojibake.cjs",
    "mobile:sync": "npx cap sync",
    "mobile:ios": "npx cap open ios",
    "mobile:android": "npx cap open android",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@clerk/nextjs": "^6.12.0",
    "@neondatabase/serverless": "^0.10.4",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@xmldom/xmldom": "^0.9.12",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^18.5.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.9.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-crypto": "^6.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "typescript": "^7",
    "vitest": "^5.1.0",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
